# -----------------------------------------------------------------------------
# AIOMetadata - LITE MODE Configuration
# Phien ban sieu nhe: tat IMDB Rating, metrics, cache warmer khong can thiet
# Ho tro: TMDB, TVDB, Anime (MAL/Anilist/Kitsu), Fanart, RPDB
# -----------------------------------------------------------------------------

# ===========================================
# LITE MODE - Bat che do sieu nhe
# ===========================================
LITE_MODE=true
DISABLE_METRICS=true

# ===========================================
# Core Configuration
# ===========================================
PORT=3232
HOST_NAME=https://your-domain.com
NODE_ENV=production
LOG_LEVEL=warn

# ===========================================
# Database & Redis
# ===========================================
DATABASE_URI=sqlite://addon/data/db.sqlite
REDIS_URL=redis://aiometadata_redis:6379

# ===========================================
# API Keys (Bat buoc: TMDB)
# ===========================================
TMDB_API_KEY=your_tmdb_api_key_here

# Tuy chon - them neu can
# TVDB_API_KEY=your_tvdb_key
# FANART_API_KEY=your_fanart_key
# RPDB_API_KEY=your_rpdb_key
# MDBLIST_API_KEY=your_mdblist_key

# ===========================================
# TAT IMDB RATING (tiet kiem ~300MB RAM)
# imdbRatings khong duoc load khi LITE_MODE=true
# Poster va metadata van day du
# ===========================================

# ===========================================
# TAT CACHE WARMER (khong request ngam)
# ===========================================
MAL_WARMUP_ENABLED=false
CACHE_WARMUP_UUIDS=
CATALOG_WARMUP_LOG_LEVEL=silent

# ===========================================
# ANIME - Giu nguyen (co dung)
# MAL / Anilist / Kitsu hoat dong binh thuong
# idMapper va animeListMapper van duoc load
# ===========================================

# ===========================================
# Security
# ===========================================
# ADMIN_KEY=your_admin_key
# CONFIG_LOAD_RATE_LIMIT_PER_MIN=30
